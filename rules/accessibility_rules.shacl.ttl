@prefix acc: <https://example.org/wheelchair-accessibility#> .
@prefix props: <https://w3id.org/props#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

acc:DoorWidthShape
    a sh:NodeShape ;
    sh:targetClass acc:IfcDoor ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "door_width|Door clear width is below 0.90 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:isRouteRelevantDoor true ;
                      acc:derivedDoorWidthM ?width .
                FILTER(xsd:decimal(?width) < 0.90)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "missing_door_width|Door clear width is missing." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            SELECT $this WHERE {
                $this acc:isRouteRelevantDoor true .
                FILTER NOT EXISTS { $this acc:derivedDoorWidthM ?width . }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "door_height|Door clear height is below 2.05 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:isRouteRelevantDoor true ;
                      acc:derivedDoorHeightM ?height .
                FILTER(xsd:decimal(?height) < 2.05)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "missing_door_height|Door clear height is missing." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            SELECT $this WHERE {
                $this acc:isRouteRelevantDoor true .
                FILTER NOT EXISTS { $this acc:derivedDoorHeightM ?height . }
            }
        """ ;
    ] .

acc:CorridorWidthShape
    a sh:NodeShape ;
    sh:targetClass acc:IfcSpace ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "corridor_width|Corridor clear width is below 1.50 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:isCorridorLike true ;
                      acc:derivedClearSpaceWidthM ?width .
                FILTER NOT EXISTS { $this acc:isExcludedSpace true . }
                FILTER(xsd:decimal(?width) < 1.50)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "corridor_slope|Corridor slope exceeds the allowed limit." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:isCorridorLike true ;
                      acc:derivedCorridorLengthM ?length ;
                      acc:derivedCorridorSlopePercent ?slope .
                FILTER NOT EXISTS { $this acc:isExcludedSpace true . }
                FILTER(
                    (xsd:decimal(?length) <= 10.0 && xsd:decimal(?slope) > 4.0) ||
                    (xsd:decimal(?length) > 10.0 && xsd:decimal(?slope) > 3.0)
                )
            }
        """ ;
    ] .

acc:CorridorPassingAreaGapShape
    a sh:NodeShape ;
    sh:targetClass acc:CorridorPassingAreaGap ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "corridor_movement_area|Passing-area spacing exceeds 15.00 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:passingAreaGapLengthM ?gap .
                FILTER(xsd:decimal(?gap) > 15.0)
            }
        """ ;
    ] .

acc:RampShape
    a sh:NodeShape ;
    sh:targetClass acc:IfcRamp ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ramp_slope|Ramp slope is above 6 percent." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:rampSlopePercent ?slope .
                FILTER(xsd:decimal(?slope) > 6.0)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ramp_width|Ramp usable width is below 1.20 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:rampUsableWidthM ?width .
                FILTER(xsd:decimal(?width) < 1.20)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ramp_run_length|Ramp flight length is above 6.00 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:rampRunLengthM ?length .
                FILTER(xsd:decimal(?length) > 6.00)
            }
        """ ;
    ] .

acc:RouteShape
    a sh:NodeShape ;
    sh:targetClass acc:RouteEdge ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "unreachable|No collision-free route exists on the 0.01 m navigation grid." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeNavigationBlocked true .
                FILTER NOT EXISTS {
                    $this acc:routeDoorWidthMinM ?doorWidth .
                    FILTER(xsd:decimal(?doorWidth) < 0.90)
                }
                FILTER NOT EXISTS {
                    $this acc:routeClearWidthM ?routeWidth .
                    FILTER(xsd:decimal(?routeWidth) < 1.50)
                }
                FILTER NOT EXISTS {
                    $this acc:routeHasTurn true ;
                          acc:routeTurningSpaceM ?turningWidth .
                    FILTER(xsd:decimal(?turningWidth) < 1.50)
                }
                FILTER NOT EXISTS { $this acc:routeHitsStair true . }
                FILTER NOT EXISTS {
                    $this acc:routeRampSlopePercent ?slope .
                    FILTER(xsd:decimal(?slope) > 6.0)
                }
                FILTER NOT EXISTS {
                    $this acc:routeRampUsableWidthM ?rampWidth .
                    FILTER(xsd:decimal(?rampWidth) < 1.20)
                }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_door_width|Route uses a door below 0.90 m clear width." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeDoorWidthMinM ?width .
                FILTER(xsd:decimal(?width) < 0.90)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_door_height|Route uses a door below 2.05 m clear height." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeDoorHeightMinM ?height .
                FILTER(xsd:decimal(?height) < 2.05)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_width|Route clear width is below 1.50 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeClearWidthM ?width .
                FILTER(xsd:decimal(?width) < 1.50)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_turning_space|Route turn does not provide a clear area of 1.50 m by 1.50 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeHasTurn true ;
                      acc:routeTurningSpaceM ?width .
                FILTER(xsd:decimal(?width) < 1.50)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "stair_block|Route intersects a stair volume." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            SELECT $this WHERE {
                $this acc:routeHitsStair true .
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_ramp_slope|Route ramp slope is above 6 percent." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeRampSlopePercent ?slope .
                FILTER(xsd:decimal(?slope) > 6.0)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_ramp_width|Route ramp usable width is below 1.20 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeRampUsableWidthM ?width .
                FILTER(xsd:decimal(?width) < 1.20)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "route_ramp_run_length|Route ramp flight length is above 6.00 m." ;
        sh:select """
            PREFIX acc: <https://example.org/wheelchair-accessibility#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this acc:routeRampRunLengthM ?length .
                FILTER(xsd:decimal(?length) > 6.00)
            }
        """ ;
    ] .
